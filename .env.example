# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
#
# LLM — 주장 추출과 판정에 쓴다. 없으면 전부 규칙 기반으로 동작하고,
# 모든 주장이 "근거 부족"으로 끝난다.
DEEPCHECK_LLM_PROVIDER=deepseek
DEEPCHECK_LLM_API_KEY=
DEEPCHECK_LLM_MODEL=deepseek-chat
# 주장 추출도 LLM으로 할지. rule로 두면 추출은 정규식, 판정만 LLM.
DEEPCHECK_CLAIM_EXTRACTOR=llm

# 네이버 검색 API — 국내 뉴스 근거. developers.naver.com에서 발급한다.
DEEPCHECK_NAVER_CLIENT_ID=
DEEPCHECK_NAVER_CLIENT_SECRET=

# Google Fact Check Tools — 전문 기관의 공개 판정. 있으면 가장 먼저 조회한다.
DEEPCHECK_GOOGLE_FACTCHECK_API_KEY=
