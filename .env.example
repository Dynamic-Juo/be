# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.
#
# LLM — 주장 추출과 판정에 쓴다. 없으면 전부 규칙 기반으로 동작하고,
# 모든 주장이 "근거 부족"으로 끝난다.
DEEPCHECK_LLM_PROVIDER=deepseek
DEEPCHECK_LLM_API_KEY=
DEEPCHECK_LLM_MODEL=deepseek-chat
# 주장 추출도 LLM으로 할지. rule로 두면 추출은 정규식, 판정만 LLM.
DEEPCHECK_CLAIM_EXTRACTOR=llm

# NAVER API HUB — 국내 뉴스·백과사전 근거.
# 기존 developers.naver.com 검색 API는 2026-07-31에 종료되고 네이버 클라우드로
# 이관됐다. console.ncloud.com > NAVER API HUB에서 애플리케이션을 등록하고
# "뉴스"(필요하면 백과사전·웹문서)를 선택한 뒤 발급된 값을 넣는다.
# 블로그·카페·지식iN은 선택하지 않는다 — 개인 게시물은 판정 근거로 쓰지 않는다.
DEEPCHECK_NAVER_CLIENT_ID=
DEEPCHECK_NAVER_CLIENT_SECRET=

# Google Fact Check Tools — 전문 기관의 공개 판정. 있으면 가장 먼저 조회한다.
DEEPCHECK_GOOGLE_FACTCHECK_API_KEY=

# 배포 helper가 컨테이너 내부 loopback에서 신규 접수를 drain/resume할 때만 사용한다.
# 32~512자의 printable ASCII 무작위 값을 별도 비밀 저장소에서 주입한다.
# 비어 있거나 형식이 약하면 내부 제어 경로는 404다.
DEEPCHECK_DEPLOYMENT_TOKEN=
# drain marker는 컨테이너 writable layer에만 두어 process restart에는 유지되고,
# force-recreate에는 새 상태로 시작한다. 파일과 상위 전용 디렉터리는 각각 0600/0700이다.
DEEPCHECK_DEPLOYMENT_STATE_FILE=/var/lib/deepcheck/deployment-admission.json
# 평상시에는 비워 둔다. 배포 helper가 새 컨테이너 시작 시 해당 transaction ID를
# 일회성으로 주입하면 첫 요청 전부터 신규 접수를 차단한다.
DEEPCHECK_START_DRAINED=
