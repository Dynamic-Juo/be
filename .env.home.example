# 복사 후 .env.home에서만 실제 값을 채운다. 이 파일에는 비밀값을 넣지 않는다.
CONAN_IMAGE=conan-be:home
CONAN_NETWORK=conan-ingress
# M4 16GB에서 다른 서비스와 공존하기 위한 시작값. 맥미니 실측 후 조정한다.
CONAN_CPUS=2
CONAN_MEMORY=3g
# 내부 연결 점검용 예시. 실제 Vercel 배포 주소가 확정되면 정확한 오리진으로 교체한다.
DEEPCHECK_CORS_ORIGINS=http://localhost:3000
DEEPCHECK_WORKERS=1
DEEPCHECK_CLAIM_WORKERS=3
DEEPCHECK_LLM_PROVIDER=deepseek
DEEPCHECK_LLM_MODEL=deepseek-chat
DEEPCHECK_LLM_BASE_URL=https://api.deepseek.com/v1
DEEPCHECK_LLM_API_KEY=
# 배포 helper의 컨테이너 내부 loopback drain/resume 전용이다.
# 32자 이상의 무작위 printable ASCII를 실제 비밀 저장소에서 주입한다.
DEEPCHECK_DEPLOYMENT_TOKEN=
# 구형 compose로 drain-capable image를 검증할 때도 제어 상태가 휘발되지 않게 한다.
# CD 전용 flattened Compose는 같은 고정 경로를 명시적으로 덮어쓴다.
DEEPCHECK_DEPLOYMENT_STATE_FILE=/var/lib/deepcheck/deployment-admission.json
DEEPCHECK_LLM_QUOTE_CHECK=true
DEEPCHECK_CLAIM_EXTRACTOR=llm
DEEPCHECK_NAVER_CLIENT_ID=
DEEPCHECK_NAVER_CLIENT_SECRET=
DEEPCHECK_EVIDENCE_PROVIDERS=naver_news,naver_encyc
DEEPCHECK_CAPTION_POLICY=off
# caption_policy와 별개. STT가 거의 아무것도 인식하지 못했을 때만 자막이
# 있는지 뒤늦게 확인해 대체한다. 끄면 STT 결과를 품질과 무관하게 그대로 쓴다.
DEEPCHECK_CAPTION_QUALITY_FALLBACK=true
DEEPCHECK_WHISPER_MODEL_SIZE=small
# 비워두면 Whisper 자동 언어 감지로 되돌아간다. 자동 감지는 배경음악·효과음만으로도
# 오판할 수 있어 기본은 한국어로 고정한다.
DEEPCHECK_WHISPER_LANGUAGE=ko
DEEPCHECK_FRAME_AGGREGATION=trimmed_mean
DEEPCHECK_MAX_FRAMES=8
DEEPCHECK_MAX_VIDEO_SEC=180
DEEPCHECK_MAX_PROCESSING_SEC=600
